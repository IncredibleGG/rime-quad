<?xml version="1.0" encoding="UTF-8"?>
<!--
  LuminaKey.app/Contents/Info.plist

  ⚠ InputMethodKit 靠這份 plist 才找得到輸入法。少任何一個鍵，症狀都是
    「裝得起來、在鍵盤選單裡看得到（或看不到）、但打不出字」，而且**沒有錯誤訊息**。
    apple/scripts/verify_app_bundle.sh 會逐項斷言，改這裡就要改那裡。

  三個必須互相對得上的名字：
    · InputMethodServerControllerClass = LuminaKeyInputController
      → Swift 端必須有 @objc(LuminaKeyInputController)，否則 NSClassFromString 找不到
        （Swift 會把類別名 mangle 成 _TtC9LuminaKey24LuminaKeyInputController）。
    · InputMethodConnectionName —— main.swift 從這裡讀，建 IMKServer 用。
    · ComponentInputModeDict 裡的 TISInputSourceID —— 必須以 bundle id 為前綴，
      否則系統不會把這個輸入模式列進「輸入來源」。
-->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleExecutable</key>
  <string>LuminaKey</string>
  <key>CFBundleIdentifier</key>
  <string>org.luminakey.inputmethod.LuminaKey</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>LuminaKey</string>
  <key>CFBundleDisplayName</key>
  <string>LuminaKey</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>__VERSION__</string>
  <key>CFBundleVersion</key>
  <string>__BUILD__</string>
  <key>CFBundleSignature</key>
  <string>lmnk</string>
  <!-- ⚠ 沒有 CFBundleIconFile 時,「系統設定 › 鍵盤 › 輸入來源」那一格是**空白方框**。
       真機回報過。tsInputModeMenuIconFileKey 只管選單列上那顆小圖示,
       清單裡顯示的是 app 圖示,兩者是兩回事,要各給一份。 -->
  <key>CFBundleIconFile</key>
  <string>LuminaKey</string>

  <!-- ⚠ 沒有 .lproj 時,輸入來源清單顯示的是 TISInputSourceID 原文
       (org.luminakey.inputmethod.LuminaKey.Hans)。真機回報過。
       實際的字面在 Resources/<lang>.lproj/InfoPlist.strings,
       鍵就是下面 tsInputModeListKey 的那兩個 id。 -->
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>zh-Hant</string>
    <string>zh-Hans</string>
  </array>

  <key>LSMinimumSystemVersion</key>
  <string>__MIN_OS__</string>
  <key>NSHumanReadableCopyright</key>
  <string>LuminaKey — GPL-3.0. Built on librime.</string>
  <key>NSPrincipalClass</key>
  <string>NSApplication</string>

  <!-- 輸入法沒有 Dock 圖示也沒有主視窗，但**必須**能建立 NSWindow（候選窗）。
       LSBackgroundOnly 允許這件事：不能被啟動成前景 app，但畫得出
       nonactivating 的 NSPanel。刻意**不**同時寫 LSUIElement —— 兩者語義重疊，
       同時寫下去由誰勝出沒有文件保證，而這是 Squirrel 等既有輸入法的作法。 -->
  <key>LSBackgroundOnly</key>
  <true/>

  <!-- ── InputMethodKit ─────────────────────────────────────── -->
  <key>InputMethodConnectionName</key>
  <string>org.luminakey.inputmethod.LuminaKey_Connection</string>
  <key>InputMethodServerControllerClass</key>
  <string>LuminaKeyInputController</string>
  <key>tsInputMethodCharacterRepertoireKey</key>
  <array>
    <string>Hani</string>
    <string>Latn</string>
  </array>

  <key>ComponentInputModeDict</key>
  <dict>
    <key>tsInputModeListKey</key>
    <dict>
      <key>org.luminakey.inputmethod.LuminaKey.Hant</key>
      <dict>
        <key>TISInputSourceID</key>
        <string>org.luminakey.inputmethod.LuminaKey.Hant</string>
        <key>TISIntendedLanguage</key>
        <string>zh-Hant</string>
        <key>tsInputModeCharacterRepertoireKey</key>
        <array>
          <string>Hani</string>
        </array>
        <key>tsInputModeIsVisibleKey</key>
        <true/>
        <key>tsInputModeDefaultStateKey</key>
        <true/>
        <key>tsInputModePrimaryInScriptKey</key>
        <true/>
        <key>tsInputModeScriptKey</key>
        <string>smTradChinese</string>
        <key>tsInputModeMenuIconFileKey</key>
        <string>LuminaKey</string>
        <key>tsInputModeAlternateMenuIconFileKey</key>
        <string>LuminaKey</string>
      </dict>
      <key>org.luminakey.inputmethod.LuminaKey.Hans</key>
      <dict>
        <key>TISInputSourceID</key>
        <string>org.luminakey.inputmethod.LuminaKey.Hans</string>
        <key>TISIntendedLanguage</key>
        <string>zh-Hans</string>
        <key>tsInputModeCharacterRepertoireKey</key>
        <array>
          <string>Hani</string>
        </array>
        <key>tsInputModeIsVisibleKey</key>
        <true/>
        <key>tsInputModeDefaultStateKey</key>
        <false/>
        <key>tsInputModePrimaryInScriptKey</key>
        <false/>
        <key>tsInputModeScriptKey</key>
        <string>smSimpChinese</string>
        <key>tsInputModeMenuIconFileKey</key>
        <string>LuminaKey</string>
        <key>tsInputModeAlternateMenuIconFileKey</key>
        <string>LuminaKey</string>
      </dict>
    </dict>
    <key>tsVisibleInputModeOrderedArrayKey</key>
    <array>
      <string>org.luminakey.inputmethod.LuminaKey.Hant</string>
      <string>org.luminakey.inputmethod.LuminaKey.Hans</string>
    </array>
  </dict>
</dict>
</plist>
