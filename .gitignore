# --- Android 模擬器 / 自動化驗證(scripts/emu.sh, scripts/verify_ime.sh)---
# 模擬器執行期產物(pid、模擬器日誌、臨時截圖)
.emulator/
# 驗證 artifact 與測試靶 APK(截圖、logcat、dumpsys、debug keystore)
build/
# 模擬器截圖(手動抓的)
screenshots/
*.screenshot.png

# --- librime 交叉編譯(scripts/build_native.sh)---
# 交叉編譯中間產物(各 ABI 的 cmake/ninja build tree 與 staging prefix)
third_party/build/
# 下載並解壓的 Boost headers(header-only,由腳本自動取得)
third_party/boost/
third_party/boost_*.tar.gz
third_party/boost_*.tar.gz.part
# clone 進來的 librime 原始碼(含其 deps 子模組),不入本倉庫
third_party/librime/
# 建置日誌
third_party/*.log

# collect_data.sh 的產物（由 third_party/rime-data 與 host opencc 產生）
/core/data/shared/
/core/data/user/
/third_party/rime-data/

# --- Android 專案(android/)---
# Gradle 執行期狀態與建置產物
.gradle/
android/build/
android/app/build/
# externalNativeBuild 的 cmake/ninja 工作目錄
android/app/.cxx/
# Kotlin 編譯器的 session 目錄
android/.kotlin/
# 本機 SDK 路徑(sdk.dir),因機器而異,不入版控
local.properties
