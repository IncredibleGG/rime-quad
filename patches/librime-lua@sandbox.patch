+static const char kRimeQuadPathSandbox[] = R"SANDBOX(
+local user_dir, shared_dir = ...
+
+-- 第一層沒跑成功就直接失敗,交給 C++ 那側 fail-closed。
+local marker = rawget(_G, "__rimequad_sandbox")
