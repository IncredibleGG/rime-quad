/* LuminaKey — English display names.

   ⚠ WHY THIS FILE EXISTS
   Without a .lproj containing these keys, macOS has no localized name for the
   input source and falls back to printing the raw TISInputSourceID. A real user
   reported seeing "org.luminakey.inputmethod.LuminaKey.Hans" in System Settings ›
   Keyboard › Input Sources. Nobody clicks on that.

   ⚠ THE KEYS ARE THE INPUT MODE IDs, VERBATIM.
   Text Input Services looks each input mode up by its own ID. The keys below
   must stay byte-identical to:
     · Info.plist → ComponentInputModeDict → tsInputModeListKey (the dict keys)
     · Info.plist → ... → TISInputSourceID
     · InputModeBinding.hantSuffix / hansSuffix in LuminaKeyKit
   apple/scripts/verify_app_bundle.sh asserts all of them agree.
*/
"CFBundleName" = "LuminaKey";
"CFBundleDisplayName" = "LuminaKey";

"org.luminakey.inputmethod.LuminaKey.Hant" = "LuminaKey (Traditional)";
"org.luminakey.inputmethod.LuminaKey.Hans" = "LuminaKey (Simplified)";
