# 產品識別 —— 這是唯一的來源。改名只改這個檔案。
#
# 為什麼要有這個檔案:
#   2026-08-09 把「四端 / RimeQuad」換成正式產品名時,同一個 IME id 在九支腳本
#   裡各寫死了一份,而且寫法各不相同(有的寫全 id、有的只寫套件名、有的把它
#   拼在字串中間)。改名之所以那麼痛,不是因為要改的地方多,是因為**沒有人
#   知道到底有幾個地方**。所以現在:值只寫在這裡,腳本一律讀進來。
#
# 格式(刻意做到最笨):
#   · 每行 `KEY=值`,值取第一個 `=` 之後的全部字元,**逐字**採用。
#   · 不做任何展開、不處理引號、不允許值裡有換行。值可以有空格。
#   · 因此**不要**在值裡寫 `${...}` —— shell 與 python 兩邊的展開行為一旦分岔,
#     就又回到「同一個名字有兩個版本」的老問題。
#   · 組合值(IME id = 套件名 + 服務類別、套件路徑 = 套件名把點換成斜線 …)
#     由 product.sh / product.py 各自推導,並由 scripts/verify_product_ids.sh
#     斷言兩邊逐字相同。
#
# 讀法:
#   shell   . "$(dirname "$0")/lib/product.sh"   → $RS_ANDROID_IME_ID …
#   python  sys.path.insert(0, .../lib); import product → product.ANDROID_IME_ID
#
# 完整的命名決定與「哪些刻意不改」見 docs/decisions/product-name.md。

# ── 產品名 ────────────────────────────────────────────────────────────────
PRODUCT_NAME=LuminaKey
PRODUCT_NAME_ZH=LuminaKey 輸入法
PRODUCT_ID_ROOT=luminakey

# ── Android ───────────────────────────────────────────────────────────────
ANDROID_APP_ID=org.luminakey.ime
# 服務類別名由 Android 那條線決定。它改的話只有這一行要動 —— IME id、
# 套件路徑、NetworkGate 的完整類別名都是從這兩行推出來的。
ANDROID_IME_SERVICE=.RimeInputMethodService

# ── macOS / iOS ───────────────────────────────────────────────────────────
MACOS_BUNDLE_ID=org.luminakey.inputmethod.LuminaKey
MACOS_SETTINGS_BUNDLE_ID=org.luminakey.inputmethod.LuminaKey.Settings
MACOS_USER_DATA_DIR=~/Library/Application Support/LuminaKey

# ── Windows ───────────────────────────────────────────────────────────────
WINDOWS_USER_DATA_DIR=%APPDATA%\LuminaKey

# ── 落地的識別碼(四端必須一致;檔名與魔術字串都在這裡) ──────────────────
# 這些是**寫進使用者磁碟**的名字。發布之後改 = 使用者的備份認不得、
# 安裝帳本與自訂鍵位讀不到。現在使用者數接近零,所以現在改。
BACKUP_MANIFEST=luminakey-backup.json
BACKUP_KIND=luminakey-backup
STORE_REGISTRY_FILE=luminakey-store.json
LAYOUTS_FILE=luminakey-layouts.json
ANDROID_PREFS_STORE=luminakey-store
ANDROID_PREFS_KEYBOARD=luminakey-current-keyboard
ANDROID_PREFS_UPDATE=luminakey-update
# `<schema>.custom.yaml` 第一行的標記。只有帶著它的檔案我們才可以覆寫 ——
# 使用者自己寫的那份裡常有他調了很久的按鍵綁定。見 docs/settings-model.md §5。
CUSTOM_PHRASE_MARKER=luminakey-managed

# librime 的 distribution 名字(rs_setup.app_name)。慣例是 `rime.<前端>`,
# 同 rime.weasel / rime.squirrel;各端再自己接 `.android` / `.macos` …
LIBRIME_APP_NAME_PREFIX=rime.luminakey

# ── 稽核用的樣式 ──────────────────────────────────────────────────────────
# User-Agent 只要含這裡任何一個詞,就等於向網路自報家門(見 audit_offline.sh
# 第 7 項與 docs/offline-threat-model.md)。**改名時這一行一定要跟著加新名字**
# —— 否則守門的還在擋舊名,新名字大搖大擺地走出去。舊名保留:我們仍然是一個
# RIME 前端,UA 裡出現 rime 一樣會暴露身分。
SELF_ID_UA_PATTERN=rime|quad|ime|lumina

# ══════════════════════════════════════════════════════════════════════════
#  以下**刻意保留舊名**。不是漏改的,改了會斷線上的東西。
# ══════════════════════════════════════════════════════════════════════════

# R2 的路徑字首。下載頁與應用內升級都指著 rime/…,改了 = 已經發出去的連結
# 全部 404、裝在使用者機器上的 app 升不上來。
R2_PREFIX=rime
R2_MACOS_DIR=macos
R2_WINDOWS_DIR=windows
# R2 上已發布的檔名字根,含 *-latest.* 那幾個指標檔。macOS/Windows 的應用內
# 升級與下載頁的舊版清單都指著它。等發布搬到 GitHub Releases 時一起換
# (見 docs/decisions/product-name.md「之後再做」)。
R2_ARTIFACT_BASE=RimeQuad
# Android 的檔名由 scripts/publish_apk.sh 產生,version.json 也記著它。
R2_ANDROID_APK_PREFIX=rime-android-
R2_ANDROID_LATEST=rime-latest.apk
# 已發布的 macOS 壓縮包裡那個 .app 叫什麼。下載頁的手動安裝指令要照著寫 ——
# 指令裡的名字和包裡的名字對不上時,使用者做完四步、系統一聲不吭地不載入它。
#
# ⚠ **這一行現在只是「R2 上還沒有那個檔案」時的退路,不再需要有人記得去改它。**
#   原本的規矩是「apple/ 改名而且發布過一版之後才手動改這一行」——
#   靠人記得翻轉一個常數是不可靠的,而漏掉的症狀是靜默失敗。現在:
#     · scripts/publish_desktop.sh 發布時**從壓縮包的內容量出** .app 的名字,
#       寫成 R2 上的 macos/app-bundle-latest.txt;
#     · scripts/downloads_server.py 讀那個檔案,讀不到才退回這裡;
#     · 發布的最後一關比對「下載頁講的名字」與「包裡實際的名字」,不一致就不准發。
#   所以這個值只在「改名後還沒發布過任何一版」的那段時間有用 —— 而那段時間裡
#   R2 上躺著的確實還是 RimeQuad.app。
MACOS_APP_BUNDLE=RimeQuad.app

# GitHub repo 名。改名會牽動所有推送腳本與 CI,不是這一輪的事。
GITHUB_REPO=rime-quad

# CI artifact 的名字由 .github/workflows/{macos,windows}.yml 決定,不在共用層。
# 那兩條線改名落地時改這裡。
CI_ARTIFACT_MACOS_APP=rime-macos-app
CI_ARTIFACT_MACOS_PKG=rime-macos-installer
CI_ARTIFACT_WINDOWS=rime-windows-x64
CI_ARTIFACT_WINDOWS_SETUP=RimeQuad-Setup-x64
# artifact **裡面**的 .app / .exe 叫什麼。apple/ 與 windows/ 那兩條線改名的
# 時間點不一定和這條線同一次合併,所以這裡列的是「依序試」的清單:新名在前,
# 舊名在後。兩個都找不到才失敗 —— 找不到就是找不到,不會靜靜地跳過。
DESKTOP_APP_BASES=LuminaKey RimeQuad

# librime / librime-lua 的沙盒符號名。它們定義在 patches/ 底下的 patch 裡,
# 而 patches/ 不在這一輪的範圍(改了就得重建 librime,而稽核比對的是**已經
# 建好的 .a**)。audit_offline.sh、verify_lua_sandbox.sh、verify_audit_offline.sh、
# verify_lua_deferral.sh 全都要用同一組字面值,所以放在這裡而不是各寫一份。
LUA_SANDBOX_SYM_STAGE1=kRimeQuadSandbox
LUA_SANDBOX_SYM_STAGE2=kRimeQuadPathSandbox
LUA_SANDBOX_INIT=rimequad_lua_ensure_init
LUA_SANDBOX_NUKE=rimequad_lua_nuke
LUA_SANDBOX_MARK=rimequad-path-sandbox
LUA_SANDBOX_GLOBAL=__rimequad_sandbox

# 舊的識別碼字根。改名的守門腳本要拿它去找「漏改的地方」。
LEGACY_ID_ROOT=rimequad
LEGACY_PRODUCT_NAME=RimeQuad
