+  for seg in rest:gmatch("[^/]+") do
+    if seg == "." then
+      -- 略過
+    elseif seg == ".." then
+      if #out == 0 then return nil end   -- 想爬到根的上面,直接拒絕
+      table.remove(out)
+    else
+      out[#out + 1] = seg
+    end
+  end
+  local s = prefix .. "/" .. table.concat(out, "/")
+  if windows then s = s:lower() end
+  return s
+end
