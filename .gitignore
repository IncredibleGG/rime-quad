# --- Android 模擬器 / 自動化驗證(scripts/emu.sh, scripts/verify_ime.sh)---
# 模擬器執行期產物(pid、模擬器日誌、臨時截圖)
.emulator/
# 驗證 artifact 與測試靶 APK(截圖、logcat、dumpsys、debug keystore)
build/
# 模擬器截圖(手動抓的)
screenshots/
*.screenshot.png

# --- librime 交叉編譯(scripts/build_native.sh)---
# 交叉編譯中間產物(各 ABI 的 cmake/ninja build tree 與 staging prefix)
third_party/build/
# 下載並解壓的 Boost headers(header-only,由腳本自動取得)
third_party/boost/
third_party/boost_*.tar.gz
third_party/boost_*.tar.gz.part
# clone 進來的 librime 原始碼(含其 deps 子模組),不入本倉庫
third_party/librime/
# clone 進來的 librime-lua 外掛原始碼(含 thirdparty/ 底下的 Lua 5.4 原始碼);
# 由 scripts/build_native.sh 依釘住的 commit 自動取得,並 symlink 到
# third_party/librime/plugins/lua 供 librime 的 plugin 機制撿走。
third_party/librime-lua/
# 建置日誌
third_party/*.log

# collect_data.sh 的產物（由 third_party/rime-data 與 host opencc 產生）
#
# ⚠ 這兩行**沒有**結尾斜線,而那不是筆誤。帶斜線的樣式只匹配目錄,而每一條
#   支線的 worktree 都是把它們 symlink 到主 repo 的那一份(交接文件要求的
#   `ln -sfn /home/lc/rime/core/data/shared <worktree>/core/data/shared`)。
#   symlink 在 git 眼裡不是目錄,`/core/data/shared/` 因此匹配不到它 ——
#   結果是**每一個 worktree 的 git status 上都永遠掛著兩筆 `??`**,而
#   release_check.sh 第 1 關(「工作區有未提交變更,這份 APK 對應不到任何
#   commit」)在每一個 worktree 上都因此是紅的。
#
#   一道永遠紅的守門和沒有守門是同一件事:它教會每個人略過那一行,而那一關
#   擋的是「發出去的 APK 對不回任何一個 commit」—— 這個專案已經差點把一份
#   別人改到一半的 APK 發給使用者(見 release_check.sh 檔頭)。
/core/data/shared
/core/data/user
/third_party/rime-data/

# --- Android 專案(android/)---
# Gradle 執行期狀態與建置產物
.gradle/
android/build/
android/app/build/
# externalNativeBuild 的 cmake/ninja 工作目錄
android/app/.cxx/
# Kotlin 編譯器的 session 目錄
android/.kotlin/
# 本機 SDK 路徑(sdk.dir),因機器而異,不入版控
local.properties

# publish_apk.sh 的暫存產物
/release/

# --- 方案市集伺服器側(scripts/build_schema_store.sh)---
# 產物(zip 與 index.json)與中間產物(clone 下來的上游庫、staging、驗證結果)
build/schema-store/
# Python 位元碼（scripts/schema_store 的輔助模組）
__pycache__/
*.pyc

# --- 簽章金鑰（絕對不可進版控）---
# 正式 keystore 與密碼放在 repo 之外的 /home/lc/rime-signing/（見該目錄的
# README.md）。這幾條是第二道防線：萬一有人把它們複製進來，git 也不收。
# 弄丟金鑰 = 所有使用者無法升級，只能解除安裝重裝並失去詞典與設定。
*.jks
*.keystore
signing.properties
signing-lineage.bin
ks-pass.txt
key-pass.txt
CREDENTIALS.txt
/rime-signing/

# 參考截圖(使用者提供,不進版控)
/docs/reference/
