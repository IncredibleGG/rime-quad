+local sep = "/"
+if type(package.config) == "string" then sep = package.config:sub(1, 1) end
+local windows = (sep == "\\")
+
+-- 字面正規化:統一成 /、解掉 . 與 ..、Windows 上大小寫不敏感。
+-- 相對路徑以使用者資料目錄為基準(市集裡沒有任何一處這樣用,但要有定義,
+-- 否則行為取決於行程的 cwd,而那不是我們控制得了的東西)。
+local function normalize(p, base)
+  if type(p) ~= "string" or p == "" then return nil end
+  if p:find("\0", 1, true) then return nil end
+  p = p:gsub("\\", "/")
+  local prefix, rest
+  local drive = p:match("^(%a:)/")
+  if drive then
+    prefix, rest = drive, p:sub(#drive + 1)
+  elseif p:sub(1, 1) == "/" then
+    prefix, rest = "", p
+  else
+    if not base then return nil end
+    return normalize(base .. "/" .. p, nil)
+  end
