<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 方案市集要拉 index.json 與套件 zip（docs/schema-store.md §1）。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        應用內更新。本專案是側載發布(不經 Google Play),升級只能自己來。

        光有這個權限不夠:API 26 起「安裝未知的應用程式」是逐 app 的授權,
        使用者必須自己去系統設定打開,只能引導不能用對話框要
        (見 UpdateInstaller.openUnknownSourcesSettings)。
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.RimeQuad">

        <!-- 設定／診斷畫面，同時是 method.xml 的 settingsActivity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            設定畫面。軟鍵盤工具列的 settings action(規範 §8.6.6.1 的必備項)
            指向這裡,使用者按下齒輪就直接落在設定,不必先經過診斷頁。
            exported=false:沒有任何外部 app 需要開它。
        -->
        <activity
            android:name=".prefs.SettingsActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <!--
            PackageInstaller 的狀態回報。

            必須是 manifest 宣告的靜態 receiver:安裝自己這個 app 的過程中,
            系統會把我們的行程收掉,動態註冊的 receiver 會一起消失,
            結果是永遠收不到成功或失敗的通知。
            exported=false:只有系統會用我們自己給出去的 PendingIntent 送進來。
        -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />

        <!-- 輸入法服務宣告 -->
        <service
            android:name=".RimeInputMethodService"
            android:exported="true"
            android:label="@string/ime_label"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

    </application>

</manifest>
